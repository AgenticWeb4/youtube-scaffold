{
  "name": "youtube-scaffold",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "tsc -b && node scripts/build-extension.mjs",
    "typecheck": "tsc -b",
    "test": "pnpm run build && node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "specs:check": "node scripts/check-specs.mjs",
    "specs:map": "node scripts/check-specs.mjs --write-map",
    "check": "pnpm run specs:check && pnpm run test && node scripts/check-architecture.mjs && node scripts/check-release.mjs",
    "package": "pnpm run check && node scripts/package-extension.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.6",
    "linkedom": "0.18.14",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
